# Database (SQLite default; swap to postgresql+psycopg2://user:pass@host:5432/adais for production)
DATABASE_URL=sqlite:///./adais.db

# Drone-specific YOLO weights path
DRONE_MODEL_WEIGHTS=weights/drone_best.pt
YOLO_CONF_THRESHOLD=0.45
YOLO_IMGSZ=640

# Monocular Depth Estimation (MiDaS_small or DPT_Hybrid)
ENABLE_DEPTH_MODEL=true
DEPTH_MODEL_TYPE=MiDaS_small

# File Upload Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=500
